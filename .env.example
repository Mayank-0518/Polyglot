# ---- API ----
API_KEY=change-me
API_URL=http://api:8000

# ---- Fixed test pair (either phone can initiate) ----
PARTY_A_NO=+919123260733
PARTY_A_LANG=bn-IN
PARTY_B_NO=+916392306428
PARTY_B_LANG=hi-IN
# Provider-owned inbound number to dial for real SIP calls (not either mobile above)
# Twilio: set your voice-capable US +1 number; also used as outbound caller ID.
# Keep this number on Programmable Voice/TwiML for inbound, not Elastic origination.
SIP_NUMBER=

# ---- AI vendors ----
# fake = no network (tests)  |  sarvam = real
VENDORS=sarvam
SARVAM_API_KEY=#for translation endpoint
GNANI_API_KEY=

# ---- LiveKit ----
# room = local tests without phones  |  sip = real phone calls
DIAL_MODE=sip
# For real calls: wss://<project>.livekit.cloud + your keys. Local Docker: ws://livekit:7880.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# LiveKit outbound trunk ID, not Twilio's TK... SID. See config/sip/ and SETUP.md.
LIVEKIT_SIP_OUTBOUND_TRUNK_ID=
# Fill all live settings before starting the agent. Local test values are in SETUP.md.
# Twilio Account SID/Auth Token and SIP credentials are configured in consoles, not used by this app.
